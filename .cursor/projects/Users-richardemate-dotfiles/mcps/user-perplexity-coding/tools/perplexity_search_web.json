{
  "name": "perplexity_search_web",
  "description": "Search the web using Perplexity AI with recency filtering",
  "arguments": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "recency": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year"
        ],
        "default": "month"
      }
    },
    "required": [
      "query"
    ]
  }
}